# Starts the welcome server at boot on a Raspberry Pi / Linux box.
# Install:
#   sudo cp welcome-tv.service /etc/systemd/system/
#   sudo systemctl enable --now welcome-tv
# Edit User= and the paths below if your copy isn't at /home/pi/airbnb-welcome-tv.
[Unit]
Description=Airbnb welcome screen server
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/airbnb-welcome-tv/server
ExecStart=/usr/bin/python3 /home/pi/airbnb-welcome-tv/server/welcome_server.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
